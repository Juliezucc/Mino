# Optional: leave these unset and Mino runs fully offline on the device
# (AsyncStorage). Set both to switch the app to the Supabase backend —
# no other change is needed, see src/data/supabaseRepository.ts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# L'adresse des fonctions de facturation, c'est-à-dire les Edge Functions du
# projet Supabase :
#
#   https://<référence-du-projet>.supabase.co/functions/v1
#
# Sans elle, `getBillingService()` retombe sur la doublure locale — y compris
# quand le module d'achat natif sera branché, puisque le rail boutique a
# besoin des deux (voir la condition dans src/services/billing/index.ts).
# Autrement dit : cette ligne vide suffit à faire croire que le paiement ne
# marche pas alors que tout le reste est en place.
EXPO_PUBLIC_BILLING_API_URL=
