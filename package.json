{
  "name": "mino",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "TZ=Europe/Paris jest",
    "test:sql": "node scripts/test-sql.mjs",
    "test:charge": "node scripts/load-test.mjs",
    "test:trafic": "node scripts/egress.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:bundle": "node scripts/db-bundle.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "typecheck": "tsc --noEmit",
    "compil": "expo export --platform web --output-dir .expo/verif-compilation",
    "faq": "node --experimental-strip-types --no-warnings scripts/export-faq.mjs",
    "stripe:produits": "node --experimental-strip-types --no-warnings scripts/stripe-produits.mjs",
    "licences": "node scripts/licences.mjs",
    "assets": "node scripts/make-launch-assets.mjs",
    "captures": "node scripts/capture-store.mjs",
    "captures:paywall": "node scripts/capture-paywall.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/nunito": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~57.0.14",
    "expo-build-properties": "^57.0.17",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-iap": "^5.5.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.7",
    "ffmpeg-static": "^5.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "playwright": "^1.63.0",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "private": true
}
