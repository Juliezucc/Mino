# ============================================================
#  app.minoapp.fr — application web Mino
#
#  Hors ligne pour les moteurs de recherche : rien de ce qui est
#  servi ici ne doit apparaître dans un résultat tant que les
#  applications ne sont pas publiées sur les boutiques.
#
#  Certificat Let's Encrypt émis le 9 septembre 2026, couvrant
#  app.minoapp.fr et www.app.minoapp.fr.
# ============================================================

# ---- 1. Une seule adresse : https://app.minoapp.fr ----
# Le www doit rediriger, et pas seulement fonctionner : APP_ORIGIN
# vaudra « https://app.minoapp.fr ». Une application chargée depuis
# www.app.minoapp.fr serait une autre origine, et tous ses appels
# aux fonctions Supabase seraient refusés par le navigateur.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.app\.minoapp\.fr$ [NC]
  RewriteRule ^ https://app.minoapp.fr%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- 2. En-têtes de sécurité ----
# L'interdiction d'indexation a été levée le 9 septembre 2026, jour de la
# publication sur l'App Store. Elle se lisait ici :
#   Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- 3. Ne pas exposer le contenu des dossiers ----
Options -Indexes

# ---- 4. Encodage ----
AddDefaultCharset UTF-8

# ---- 5. Application à page unique ----
# L'export Expo est en « output: single » : toute route inconnue
# doit rendre index.html, sinon un rechargement sur une route
# interne tombe en 404.
<IfModule mod_rewrite.c>
  # _expo/ et assets/ sont exclus du repli : ce sont des fichiers, pas des
  # routes. Sans cette exclusion, un bundle supprimé par un déploiement
  # renvoie la page HTML au lieu d'un 404 — et le navigateur qui l'avait
  # en cache reçoit du HTML là où il attend du JavaScript, ce qui échoue
  # sur une erreur de syntaxe incompréhensible plutôt que franchement.
  RewriteCond %{REQUEST_URI} !^/(_expo|assets)/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# ---- 6. Cache ----
# index.html porte le nom du bundle, qui change à chaque export : il doit
# être revalidé à chaque visite, sinon le navigateur garde l'ancienne page
# et il faut un rechargement forcé après chaque publication.
# Les fichiers de _expo/ et assets/ portent une empreinte dans leur nom :
# ils peuvent être gardés longtemps sans risque.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>
