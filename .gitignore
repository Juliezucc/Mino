# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env` compris, et pas seulement `.env.local` : c'est le fichier que
# `docs/ops/mise-en-route.md` fait créer, et il porte les clés du projet
# Supabase. Celle de l'application est publique par construction — elle part
# dans le bundle — mais rien de tout cela n'a à entrer dans le dépôt, et le
# jour où une clé `service_role` s'y glisserait, il serait trop tard.
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Regenerable from docs/mascot-tests/ with scripts/video-to-sequence.mjs
assets/mascot/sequence/*-frames/

# Visuels des fiches App Store et Play : régénérés par `npm run captures`.
# Versionner vingt-six PNG lourds ferait grossir le dépôt à chaque retouche de
# légende, pour des fichiers que le script refait en deux minutes.
/store/
