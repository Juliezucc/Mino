{
  "expo": {
    "name": "Mino",
    "slug": "mino",
    "owner": "juliemino",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "mino",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.minoapp.mino",
      "appleTeamId": "C8F2CKP8SZ",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.fr.minoapp.mino"
        ]
      }
    },
    "android": {
      "package": "fr.minoapp.mino",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F6FF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4EB6FF",
          "defaultChannel": "mino"
        }
      ],
      "expo-iap",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Grandir, une mission à la fois. Les enfants gagnent leur temps d’écran en accomplissant de petites responsabilités du quotidien.",
    "primaryColor": "#4EB6FF",
    "backgroundColor": "#F2F6FF",
    "extra": {
      "eas": {
        "projectId": "8dccb862-cd00-4967-91fc-ac260e156380"
      }
    }
  }
}
