{
  "expo": {
    "name": "Mino",
    "slug": "mino",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mino",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.mino.app"
    },
    "android": {
      "package": "fr.mino.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F6FF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
