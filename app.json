{
  "expo": {
    "name": "Mino",
    "slug": "mino",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mino",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.minoapp.mino",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Mino ne suit personne : aucune publicité, aucun traceur."
      }
    },
    "android": {
      "package": "fr.minoapp.mino",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F6FF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4EB6FF",
          "defaultChannel": "mino"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Grandir, une mission à la fois. Les enfants gagnent leur temps d’écran en accomplissant de petites responsabilités du quotidien.",
    "primaryColor": "#4EB6FF",
    "backgroundColor": "#F2F6FF"
  }
}
